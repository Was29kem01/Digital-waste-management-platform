// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  FIELD_AGENT
  STATION_MANAGER
  STATION_ADMIN
  ADMIN
  SUPER_ADMIN
}

enum ReportStatus {
  PENDING
  RECEIVED
  VERIFIED
  ASSIGNED
  COLLECTED
  OUT_OF_COVERAGE
  RESOLVED_ALREADY_CLEAN
}

enum PriorityLevel {
  NORMAL
  HIGH
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CLIENT)
  branchId  Int?
  branch    Branch?  @relation("BranchStaff", fields: [branchId], references: [id])
  
  // Relations
  submittedReports Report[] @relation("SubmittedReports")
  assignedReports  Report[] @relation("AssignedReports")
  activityLogs     ReportActivityLog[]
  applications     Application[]
  notifications    Notification[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id       Int     @id @default(autoincrement())
  name     String
  zone     String?
  
  // Relations
  users    User[]   @relation("BranchStaff")
  reports  Report[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id          Int           @id @default(autoincrement())
  photoUrl    String?
  status      ReportStatus  @default(PENDING)
  latitude    Float
  longitude   Float
  priority    PriorityLevel @default(NORMAL)
  
  // Relations
  submitterId Int
  submitter   User          @relation("SubmittedReports", fields: [submitterId], references: [id])
  
  assignedToId Int?
  assignedTo   User?        @relation("AssignedReports", fields: [assignedToId], references: [id])
  
  branchId    Int?
  branch      Branch?       @relation(fields: [branchId], references: [id])
  
  activityLogs ReportActivityLog[]
  
  createdAt   DateTime      @default(now())
  collectedAt DateTime?
  updatedAt   DateTime      @updatedAt
}

model ReportActivityLog {
  id             Int          @id @default(autoincrement())
  action         String
  previousStatus ReportStatus?
  newStatus      ReportStatus?
  success        Boolean
  note           String?      @db.Text
  
  // Relations
  reportId       Int
  report         Report       @relation(fields: [reportId], references: [id])
  
  userId         Int
  user           User         @relation(fields: [userId], references: [id])
  
  timestamp      DateTime     @default(now())
}

model Application {
  id            Int               @id @default(autoincrement())
  requestedRole Role
  status        ApplicationStatus @default(PENDING)
  description   String?           @db.Text
  
  // Relations
  userId        Int
  user          User              @relation(fields: [userId], references: [id])
  
  documents     Document[]
  
  submittedAt   DateTime          @default(now())
  reviewedAt    DateTime?
  updatedAt     DateTime          @updatedAt
}

model Document {
  id            Int         @id @default(autoincrement())
  type          String      // e.g. "diploma", "vehicle_photo"
  fileUrl       String
  
  // Relations
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id])
  
  uploadedAt    DateTime    @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  
  // Relations
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
}